<resources>
    <style name="Theme.Lab1" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#1C1C1E</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_container</item>
        <item name="colorSecondaryContainer">@color/nav_indicator</item>
        <item name="colorOnSecondaryContainer">@color/nav_active</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/nav_background</item>
        <item name="android:colorBackground">@color/nav_background</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/WhiteButtonStyle</item>
    </style>

    <style name="WhiteButtonStyle" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">#121212</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="iconGravity">start</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SmallBottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:minHeight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
    </style>

    <style name="LogoutButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@android:color/black</item>
        <item name="strokeColor">#FF0000</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CircleShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
